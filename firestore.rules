rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CONTAHUB SECURITY RULES - PROTOTYPING MODE
     */

    // --- Global Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    function getUserData() {
      // Safely get user data, handle case where doc might not exist yet
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().profile == role;
    }

    function isAdminOrSocio() {
      let profile = getUserData().profile;
      return isSignedIn() && (profile == 'ADMINISTRADOR' || profile == 'SÓCIO' || profile == 'Administrador');
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); 
      allow create: if isSignedIn(); 
      allow update: if isSignedIn(); 
      allow delete: if isAdminOrSocio();

      match /notifications/{notificationId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
      }
    }

    match /departments/{id} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdminOrSocio();
    }

    match /officeSettings/{id} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdminOrSocio();
    }

    match /clients/{clientId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdminOrSocio();
    }

    match /tasks/{id} {
      allow read, write: if isSignedIn();
    }

    match /tickets/{id} {
      allow read, write: if isSignedIn();
    }

    match /receivables/{id} {
      allow read, write: if isSignedIn();
    }

    match /payables/{id} {
      allow read, write: if isSignedIn();
    }

    match /irpf_declarations/{id} {
      allow read, write: if isSignedIn();
    }

    match /clientAccesses/{id} {
      allow read, write: if isSignedIn();
    }

    match /installments/{id} {
      allow read, write: if isSignedIn();
    }

    match /actionLogs/{actionLogId} {
      allow get, list: if isAdminOrSocio();
      allow create: if isSignedIn();
    }
  }
}