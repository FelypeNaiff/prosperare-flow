
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * MODO PROTOTIPAGEM TOTAL - PROSPERARE FLOW
     * Permite acesso total a qualquer coleção para usuários logados.
     * Isso evita erros de permissão durante o desenvolvimento de novos módulos.
     */
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
