
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * MODO PROTOTIPAGEM TOTAL - PROSPERARE FLOW
     * Permite acesso total a qualquer coleção para usuários logados.
     * Adicionando regras explícitas para coleções principais para garantir a propagação correta.
     */
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    match /notifications/{docId} {
      allow read, write: if request.auth != null;
    }

    match /users/{docId} {
      allow read, write: if request.auth != null;
    }

    match /clients/{docId} {
      allow read, write: if request.auth != null;
    }

    match /processos/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
