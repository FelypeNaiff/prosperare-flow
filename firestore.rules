rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CONTAHUB SECURITY RULES - PROTOTYPING MODE
     *
     * CORE PHILOSOPHY:
     * This ruleset implements a strict Role-Based Access Control (RBAC) model combined with 
     * Resource-Based Ownership. Access is primarily dictated by a user's 'profile' (role) 
     * and their assignment to specific clients.
     *
     * DATA STRUCTURE:
     * - Global Configurations: /departments, /officeSettings, /fiscalObligationTemplates.
     * - User-Scoped Data: /users/{userId} and /users/{userId}/notifications.
     * - Client-Centric Data: All client-related entities are nested under /clients/{clientId}.
     * - System-Wide Operations: /expenses and /actionLogs.
     *
     * KEY SECURITY DECISIONS:
     * 1. Authorization Independence: Critical authorization fields (accountingContactUserId) are 
     *    denormalized into subcollections. This allows for flat, performant security checks 
     *    without expensive parent document lookups (get() calls).
     * 2. Role Hierarchy: 'Administrador' and 'Sócio' have elevated write permissions across the 
     *    system. 'Contador/Gestor' access is restricted to clients they are assigned to.
     * 3. Identity Source of Truth: All authorization decisions are strictly bound to 
     *    Firebase Authentication (request.auth).
     * 4. Prototyping Flexibility: Rules focus on "Who can access what" (Authorization) and 
     *    "Relationship Integrity" rather than strict data type validation.
     */

    // --- Global Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().profile == role;
    }

    function isAdminOrSocio() {
      return isSignedIn() && (hasRole('Administrador') || hasRole('Sócio'));
    }

    // Checks if the document belongs to the accountant currently logged in
    function isAssignedAccountant(data) {
      return isSignedIn() && data.accountingContactUserId == request.auth.uid;
    }

    // --- Collection Rules ---

    /**
     * @description Rules for user profiles. Users can manage their own profile; Admins manage all.
     * @path /users/{userId}
     * @allow (get, update) if isOwner(userId).
     * @deny (create) if the user ID in data doesn't match the path ID.
     * @principle Enforces path-based ownership and relational integrity.
     */
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdminOrSocio();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if (isOwner(userId) || isAdminOrSocio()) && request.resource.data.id == resource.data.id;
      allow delete: if isAdminOrSocio() && resource != null;

      /**
       * @description User-specific notifications.
       * @path /users/{userId}/notifications/{notificationId}
       * @allow (list) if the user is the owner of the path.
       * @deny (read) if requesting notifications of another user.
       * @principle Strict structural segregation for private user data.
       */
      match /notifications/{notificationId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);
      }
    }

    /**
     * @description Global office configurations. Readable by all staff, writable only by Admins/Sócios.
     * @path /departments/{departmentId}
     * @path /officeSettings/{settingId}
     * @path /fiscalObligationTemplates/{templateId}
     * @allow (get, list) if the user is signed in.
     * @deny (write) if the user is not an Admin or Sócio.
     * @principle Centralized configuration protection.
     */
    match /departments/{id} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdminOrSocio() && (request.method == 'create' || resource != null);
    }

    match /officeSettings/{id} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdminOrSocio() && (request.method == 'create' || resource != null);
    }

    match /fiscalObligationTemplates/{id} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdminOrSocio() && (request.method == 'create' || resource != null);
    }

    /**
     * @description Client records. Access is restricted to Admins/Sócios or the assigned accountant.
     * @path /clients/{clientId}
     * @allow (create) if the user is an Admin/Sócio.
     * @deny (update) if the accountant is not assigned to this client and is not an Admin.
     * @principle Shared access model based on denormalized assignment fields.
     */
    match /clients/{clientId} {
      allow get, list: if isAdminOrSocio() || isAssignedAccountant(resource.data);
      allow create: if isAdminOrSocio() && request.resource.data.id == clientId;
      allow update: if (isAdminOrSocio() || isAssignedAccountant(resource.data)) && resource != null && request.resource.data.id == resource.data.id;
      allow delete: if isAdminOrSocio() && resource != null;

      // Subcollections use denormalized accountingContactUserId for "Authorization Independence"
      
      match /processes/{id} {
        allow get, list: if isAdminOrSocio() || isAssignedAccountant(resource.data);
        allow create: if (isAdminOrSocio() || isAssignedAccountant(request.resource.data)) && request.resource.data.clientId == clientId;
        allow update: if (isAdminOrSocio() || isAssignedAccountant(resource.data)) && resource != null && request.resource.data.clientId == resource.data.clientId;
        allow delete: if (isAdminOrSocio() || isAssignedAccountant(resource.data)) && resource != null;

        match /checklistItems/{itemId} {
          allow get, list: if isAdminOrSocio() || isAssignedAccountant(resource.data);
          allow create: if (isAdminOrSocio() || isAssignedAccountant(request.resource.data)) && request.resource.data.processId == id;
          allow update: if (isAdminOrSocio() || isAssignedAccountant(resource.data)) && resource != null && request.resource.data.processId == resource.data.processId;
          allow delete: if (isAdminOrSocio() || isAssignedAccountant(resource.data)) && resource != null;
        }
      }

      match /certificates/{id} {
        allow get, list: if isAdminOrSocio() || isAssignedAccountant(resource.data);
        allow create: if (isAdminOrSocio() || isAssignedAccountant(request.resource.data)) && request.resource.data.clientId == clientId;
        allow update: if (isAdminOrSocio() || isAssignedAccountant(resource.data)) && resource != null;
        allow delete: if (isAdminOrSocio() || isAssignedAccountant(resource.data)) && resource != null;
      }

      match /honorariums/{id} {
        allow get, list: if isAdminOrSocio() || isAssignedAccountant(resource.data);
        allow create: if isAdminOrSocio() && request.resource.data.clientId == clientId;
        allow update: if isAdminOrSocio() && resource != null;
        allow delete: if isAdminOrSocio() && resource != null;
      }

      match /documents/{id} {
        allow get, list: if isAdminOrSocio() || isAssignedAccountant(resource.data);
        allow create: if (isAdminOrSocio() || isAssignedAccountant(request.resource.data)) && request.resource.data.clientId == clientId;
        allow update: if (isAdminOrSocio() || isAssignedAccountant(resource.data)) && resource != null;
        allow delete: if (isAdminOrSocio() || isAssignedAccountant(resource.data)) && resource != null;
      }
    }

    /**
     * @description Office expenses. Admins/Sócios have full access; Accountants have read-only access.
     * @path /expenses/{expenseId}
     * @allow (get) if the user has a valid profile.
     * @deny (create, update, delete) if the user is a Contador/Gestor.
     * @principle Role-based filtering for financial data.
     */
    match /expenses/{expenseId} {
      allow get, list: if isAdminOrSocio() || hasRole('Contador/Gestor');
      allow create: if isAdminOrSocio();
      allow update, delete: if isAdminOrSocio() && resource != null;
    }

    /**
     * @description System audit logs. Restricted to high-level management.
     * @path /actionLogs/{actionLogId}
     * @allow (create) if the user is signed in (logs are generated by actions).
     * @deny (get, list) for any role other than Admin or Sócio.
     * @principle Protects audit integrity.
     */
    match /actionLogs/{actionLogId} {
      allow get, list: if isAdminOrSocio();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Audit logs are immutable
    }
  }
}