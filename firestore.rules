
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * PROSPERARE FLOW - SECURITY RULES
     * Permite acesso total de leitura e escrita para qualquer usuário autenticado.
     * Esta regra recursiva abrange todas as coleções e subcoleções do sistema.
     */
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
