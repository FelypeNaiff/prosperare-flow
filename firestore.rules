rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CONTAHUB SECURITY RULES - PROTOTYPING MODE
     */

    // --- Global Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    function getUserData() {
      // Safely get user data, handle case where doc might not exist yet
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().profile == role;
    }

    function isAdminOrSocio() {
      // In prototyping, if the user doc doesn't exist, we might need a fallback or assume admin for the first user
      // For now, we trust the profile field in the users collection
      let profile = getUserData().profile;
      return isSignedIn() && (profile == 'ADMINISTRADOR' || profile == 'SÓCIO' || profile == 'Administrador');
    }

    function isAssignedAccountant(data) {
      return isSignedIn() && data.accountingContactUserId == request.auth.uid;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // Allow listing users for department/responsible selection
      allow create: if isSignedIn(); // Allow creation during onboarding/invite
      allow update: if isSignedIn(); // Simplified for prototyping stability
      allow delete: if isAdminOrSocio();

      match /notifications/{notificationId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
      }
    }

    match /departments/{id} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdminOrSocio();
    }

    match /officeSettings/{id} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdminOrSocio();
    }

    match /fiscalObligationTemplates/{id} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdminOrSocio();
    }

    match /clients/{clientId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdminOrSocio();

      match /processes/{id} {
        allow read, write: if isSignedIn();
        match /checklistItems/{itemId} {
          allow read, write: if isSignedIn();
        }
      }

      match /certificates/{id} {
        allow read, write: if isSignedIn();
      }

      match /honorariums/{id} {
        allow read, write: if isSignedIn();
      }

      match /documents/{id} {
        allow read, write: if isSignedIn();
      }
    }

    match /expenses/{expenseId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdminOrSocio();
    }

    match /actionLogs/{actionLogId} {
      allow get, list: if isAdminOrSocio();
      allow create: if isSignedIn();
    }
  }
}