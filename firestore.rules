rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CONTAHUB SECURITY RULES - PROTOTYPING MODE
     * 
     * Core Philosophy:
     * This ruleset implements a Database-Based Access Control (DBAC) model for an accounting office.
     * It prioritizes Authorization Independence by relying on denormalized fields (like 'accountingResponsibleId')
     * to perform fast, secure checks without expensive cross-document lookups.
     * 
     * Data Structure:
     * - /users/{userId}: Private user profiles and notifications.
     * - /clients/{clientId}: Central business entity. All client-related data (processes, certificates, 
     *   documents, digital certificates) are stored as subcollections of the client.
     * - /expenses, /action_history, /app_settings: Global administrative collections.
     * 
     * Key Security Decisions:
     * - Strict Role Hierarchy: Access levels are defined by 'ADMINISTRADOR', 'SÓCIO', 'CONTADOR/GESTOR', and 'ASSISTENTE'.
     * - Denormalization: Fields like 'clientAccountingResponsibleId' are required on subcollection documents 
     *   to allow individual document security and collection group queries.
     * - Structural Segregation: User-specific data (notifications) is separated from client-specific data.
     * - Prototyping Flexibility: Logic enforces "Who" can write, but does not strictly validate the 
     *   internal "What" (schema/types) of the business data.
     */

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Retrieves user profile data from the database
    function getUserData() {
      // NOTE: This assumes /users/{request.auth.uid} is readable by the user,
      // which is enforced in the /users/{userId} rule.
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().profile == role;
    }

    // High-level roles for administrative access
    function isAdmin() {
      return hasRole('ADMINISTRADOR') || hasRole('SÓCIO');
    }

    // Checks if the user is the primary accounting responsible for a client or sub-item
    function isAccountingResponsible(responsibleId) {
      return isSignedIn() && request.auth.uid == responsibleId;
    }

    // --- COLLECTION RULES ---

    /**
     * @description Rules for the User collection. Users can manage their own profile; Admins can see all.
     * @path /users/{userId}
     * @allow (get) Any signed-in user fetching their own profile.
     * @deny (list) Users attempting to list other users without Admin privileges.
     * @principle Path-based ownership combined with DBAC for administrative oversight.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && (request.resource.data.profile == resource.data.profile); // Prevent self-elevation
      allow delete: if isAdmin();

      /**
       * @description System notifications for specific users.
       * @path /users/{userId}/notifications/{notificationId}
       * @allow (create) System or Admin creating a notification for a user.
       * @deny (read) User 'A' trying to read notifications for User 'B'.
       */
      match /notifications/{notificationId} {
        allow get, list: if isOwner(userId);
        allow create: if isSignedIn(); // In prototype, allow creation if authenticated
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

    /**
     * @description Client company records. Accessible by staff based on their roles and responsibility.
     * @path /clients/{clientId}
     * @allow (create) Admins or Accountants creating a new client.
     * @deny (delete) Assistant roles trying to remove a client record.
     */
    match /clients/{clientId} {
      allow get, list: if isSignedIn(); // Basic read allowed for all authenticated staff
      allow create: if isAdmin() || hasRole('CONTADOR/GESTOR');
      allow update: if isAdmin() || isAccountingResponsible(resource.data.accountingResponsibleId);
      allow delete: if isAdmin();

      // --- CLIENT SUBCOLLECTIONS ---
      // These follow a pattern where the 'clientAccountingResponsibleId' is denormalized.

      /**
       * @description Fiscal processes, documents, and certificates linked to a client.
       * @path /clients/{clientId}/[subcollection]/{id}
       */
      match /processes/{id} { 
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.clientId == clientId;
        allow update, delete: if resource != null && (isAdmin() || isAccountingResponsible(resource.data.clientAccountingResponsibleId));
      }

      match /certificates/{id} { 
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.clientId == clientId;
        allow update, delete: if resource != null && (isAdmin() || isAccountingResponsible(resource.data.clientAccountingResponsibleId));
      }

      match /honorariums/{id} { 
        allow read: if isAdmin() || hasRole('CONTADOR/GESTOR');
        allow create: if isAdmin() || hasRole('CONTADOR/GESTOR');
        allow update, delete: if resource != null && isAdmin();
      }

      match /documents/{id} { 
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.clientId == clientId;
        allow update, delete: if resource != null && (isAdmin() || isAccountingResponsible(resource.data.clientAccountingResponsibleId));
      }

      /**
       * @description Metadata for Digital Certificates.
       * @path /clients/{clientId}/digital_certificates/{id}
       * @allow (create) Responsible accountant adding a certificate.
       * @deny (update) Changing the clientId association after creation.
       */
      match /digital_certificates/{id} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.clientId == clientId;
        allow update: if resource != null && (isAdmin() || isAccountingResponsible(resource.data.clientAccountingResponsibleId)) 
                      && request.resource.data.clientId == resource.data.clientId;
        allow delete: if resource != null && isAdmin();
      }
    }

    /**
     * @description Recursive match for deeper nesting in processes (Checklists).
     */
    match /clients/{clientId}/processes/{processId}/checklistItems/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.processId == processId;
      allow update: if resource != null && (isAdmin() || isAccountingResponsible(resource.data.clientAccountingResponsibleId) || isAccountingResponsible(resource.data.responsibleId));
      allow delete: if resource != null && isAdmin();
    }

    /**
     * @description Office operational expenses.
     * @path /expenses/{expenseId}
     * @allow (read) Sócio or Admin viewing office costs.
     * @deny (write) Accountants or Assistants creating expense entries.
     */
    match /expenses/{expenseId} {
      allow get, list: if isAdmin() || hasRole('CONTADOR/GESTOR');
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Audit logs of system actions.
     * @path /action_history/{actionId}
     * @allow (list) Admins reviewing logs.
     * @deny (write) Any direct client-side modification (should be server-triggered).
     */
    match /action_history/{actionId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn(); // Allow logging actions
      allow update, delete: if false; // Audit logs are immutable
    }

    /**
     * @description Global application settings.
     * @path /app_settings/global_settings
     */
    match /app_settings/global_settings {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    /**
     * @description Templates for fiscal obligations.
     * @path /fiscal_schedule_templates/{templateId}
     */
    match /fiscal_schedule_templates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- COLLECTION GROUP RULES ---
    // Essential for "My Tasks" or "My Clients" views across all clients.

    match /{path=**}/processes/{processId} {
      allow list: if isSignedIn(); 
    }
    
    match /{path=**}/checklistItems/{itemId} {
      allow list: if isSignedIn();
    }

  }
}