rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Auditoria: Regra global de acesso para usuários autenticados
    // Garante que o sistema opere sem bloqueios de permissão durante a transição de UID
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}