
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "profile": { "type": "string", "enum": ["ADMINISTRADOR", "SÓCIO", "CONTADOR/GESTOR", "ASSISTENTE"] },
        "role": { "type": "string" },
        "status": { "type": "string", "enum": ["ATIVO", "INATIVO"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "departmentIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "fullName", "email", "role", "status", "createdAt"]
    },
    "Client": {
      "title": "Client",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "corporateName": { "type": "string" },
        "nomeFantasia": { "type": "string" },
        "cnpj": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "taxRegime": { "type": "string" },
        "openingDate": { "type": "string" },
        "primaryCnae": { "type": "string" },
        "address": { "type": "string" },
        "neighborhood": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "zipCode": { "type": "string" },
        "status": { "type": "string" },
        "healthScore": { "type": "number" },
        "accountingContactUserId": { "type": "string" },
        "honorariumValue": { "type": "number" },
        "honorariumDueDateDay": { "type": "number" },
        "obligationGroups": { "type": "array", "items": { "type": "string" } }
      }
    },
    "License": {
      "title": "License",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "type": { "type": "string", "enum": ["Prefeitura", "Bombeiro", "Sanitário", "Ambiental", "Outros"] },
        "description": { "type": "string" },
        "issueDate": { "type": "string", "format": "date" },
        "expiryDate": { "type": "string", "format": "date" },
        "status": { "type": "string" },
        "fileUrl": { "type": "string" }
      },
      "required": ["id", "clientId", "type", "expiryDate"]
    },
    "Process": {
      "title": "Process",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nomeProcesso": { "type": "string" },
        "situacao": { "type": "string" },
        "departamento": { "type": "string" },
        "clienteId": { "type": "string" },
        "responsavelId": { "type": "string" },
        "auxiliarId": { "type": "string" },
        "prazo": { "type": "string", "format": "date-time" },
        "competencia": { "type": "string" }
      }
    },
    "Task": {
      "title": "Task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string" },
        "clientId": { "type": "string" },
        "responsibleId": { "type": "string" }
      }
    },
    "ProcessModel": {
      "title": "ProcessModel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "departamento": { "type": "string" },
        "groupIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Certification": {
      "title": "Certification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tipo": { "type": "string" },
        "clientId": { "type": "string" },
        "validade": { "type": "string" }
      }
    },
    "Notification": {
      "title": "Notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" }
      }
    },
    "FinancialEntry": {
      "title": "FinancialEntry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "valor": { "type": "number" }
      }
    },
    "Contract": {
      "title": "Contract",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "value": { "type": "number" }
      }
    },
    "ObligationGroup": {
      "title": "ObligationGroup",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "Installment": {
      "title": "Installment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" }
      }
    },
    "IrpfDeclaration": {
      "title": "IrpfDeclaration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "cpf": { "type": "string" }
      }
    },
    "ClientAccess": {
      "title": "ClientAccess",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" }
      }
    },
    "Payable": {
      "title": "Payable",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "valor": { "type": "number" }
      }
    },
    "Receivable": {
      "title": "Receivable",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "valor": { "type": "number" }
      }
    },
    "IrpfStage": {
      "title": "IrpfStage",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "order": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/User" },
      "description": "User profiles indexed by Auth UID."
    },
    "/clients/{id}": {
      "schema": { "$ref": "#/backend/entities/Client" },
      "description": "Client database."
    },
    "/licenses/{id}": {
      "schema": { "$ref": "#/backend/entities/License" },
      "description": "Municipality and Fire Department licenses."
    },
    "/processes/{id}": {
      "schema": { "$ref": "#/backend/entities/Process" },
      "description": "Active processes."
    },
    "/tasks/{id}": {
      "schema": { "$ref": "#/backend/entities/Task" },
      "description": "Internal tickets and tasks."
    },
    "/processoModelos/{id}": {
      "schema": { "$ref": "#/backend/entities/ProcessModel" },
      "description": "Checklist templates."
    },
    "/certifications/{id}": {
      "schema": { "$ref": "#/backend/entities/Certification" },
      "description": "Client certifications."
    },
    "/notifications/{id}": {
      "schema": { "$ref": "#/backend/entities/Notification" },
      "description": "Notification system."
    },
    "/chatMessages/{id}": {
      "schema": { "$ref": "#/backend/entities/ChatMessage" },
      "description": "Team chat."
    },
    "/financialEntries/{id}": {
      "schema": { "$ref": "#/backend/entities/FinancialEntry" },
      "description": "Financial records."
    },
    "/contracts/{id}": {
      "schema": { "$ref": "#/backend/entities/Contract" },
      "description": "Service contracts."
    },
    "/obligation_groups/{id}": {
      "schema": { "$ref": "#/backend/entities/ObligationGroup" },
      "description": "Groups for automation."
    },
    "/installments/{id}": {
      "schema": { "$ref": "#/backend/entities/Installment" },
      "description": "Debt installments."
    },
    "/irpf_declarations/{id}": {
      "schema": { "$ref": "#/backend/entities/IrpfDeclaration" },
      "description": "Tax declarations."
    },
    "/clientAccesses/{id}": {
      "schema": { "$ref": "#/backend/entities/ClientAccess" },
      "description": "Password vault."
    },
    "/payables/{id}": {
      "schema": { "$ref": "#/backend/entities/Payable" },
      "description": "Accounts payable."
    },
    "/receivables/{id}": {
      "schema": { "$ref": "#/backend/entities/Receivable" },
      "description": "Accounts receivable."
    },
    "/irpf_stages/{id}": {
      "schema": { "$ref": "#/backend/entities/IrpfStage" },
      "description": "IRPF Kanban stages."
    }
  }
}
