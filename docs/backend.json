{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents a user account within the system.",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "profile": { "type": "string", "enum": ["ADMINISTRADOR", "SÓCIO", "CONTADOR/GESTOR", "ASSISTENTE"] },
        "role": { "type": "string" },
        "status": { "type": "string", "enum": ["ATIVO", "INATIVO"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "departmentIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "fullName", "email", "role", "status", "createdAt"]
    },
    "Client": {
      "title": "Client",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "corporateName": { "type": "string" },
        "cnpj": { "type": "string" },
        "email": { "type": "string" },
        "taxRegime": { "type": "string" },
        "healthScore": { "type": "number" }
      }
    },
    "Process": {
      "title": "Process",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nomeProcesso": { "type": "string" },
        "situacao": { "type": "string" },
        "clienteId": { "type": "string" }
      }
    },
    "Task": {
      "title": "Task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string" },
        "clientId": { "type": "string" }
      }
    },
    "ProcessModel": {
      "title": "ProcessModel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" }
      }
    },
    "Certification": {
      "title": "Certification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tipo": { "type": "string" }
      }
    },
    "Notification": {
      "title": "Notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" }
      }
    },
    "FinancialEntry": {
      "title": "FinancialEntry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "valor": { "type": "number" }
      }
    },
    "Contract": {
      "title": "Contract",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "value": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/User" },
      "description": "User profiles indexed by Auth UID."
    },
    "/clients/{id}": {
      "schema": { "$ref": "#/backend/entities/Client" },
      "description": "Client database."
    },
    "/processes/{id}": {
      "schema": { "$ref": "#/backend/entities/Process" },
      "description": "Active processes."
    },
    "/tasks/{id}": {
      "schema": { "$ref": "#/backend/entities/Task" },
      "description": "Tasks within processes."
    },
    "/processoModelos/{id}": {
      "schema": { "$ref": "#/backend/entities/ProcessModel" },
      "description": "Checklist templates."
    },
    "/certifications/{id}": {
      "schema": { "$ref": "#/backend/entities/Certification" },
      "description": "Client certifications."
    },
    "/notifications/{id}": {
      "schema": { "$ref": "#/backend/entities/Notification" },
      "description": "Notification system."
    },
    "/chatMessages/{id}": {
      "schema": { "$ref": "#/backend/entities/ChatMessage" },
      "description": "Team chat."
    },
    "/financialEntries/{id}": {
      "schema": { "$ref": "#/backend/entities/FinancialEntry" },
      "description": "Financial records."
    },
    "/contracts/{id}": {
      "schema": { "$ref": "#/backend/entities/Contract" },
      "description": "Service contracts."
    }
  }
}