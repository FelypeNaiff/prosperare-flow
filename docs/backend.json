{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents a user account within the system.",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "profile": { "type": "string", "enum": ["ADMINISTRADOR", "SÓCIO", "CONTADOR/GESTOR", "ASSISTENTE"] },
        "role": { "type": "string" },
        "status": { "type": "string", "enum": ["ATIVO", "INATIVO"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName", "email", "profile", "status", "createdAt"]
    },
    "Client": {
      "title": "Client",
      "type": "object",
      "description": "Client account details.",
      "properties": {
        "id": { "type": "string" },
        "corporateName": { "type": "string" },
        "cnpj": { "type": "string" },
        "email": { "type": "string" }
      }
    },
    "Processo": {
      "title": "Processo",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nomeProcesso": { "type": "string" },
        "situacao": { "type": "string" }
      }
    },
    "Task": {
      "title": "Task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "ProcessoModelo": {
      "title": "ProcessoModelo",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" }
      }
    },
    "Certification": {
      "title": "Certification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tipo": { "type": "string" }
      }
    },
    "Notification": {
      "title": "Notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "read": { "type": "boolean" }
      }
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" }
      }
    },
    "FinancialEntry": {
      "title": "FinancialEntry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "valor": { "type": "number" }
      }
    },
    "Contract": {
      "title": "Contract",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "value": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/User" },
      "description": "User profiles indexed by UID."
    },
    "/clients/{id}": {
      "schema": { "$ref": "#/backend/entities/Client" },
      "description": "Client database."
    },
    "/processos/{id}": {
      "schema": { "$ref": "#/backend/entities/Processo" },
      "description": "Active processes."
    },
    "/tasks/{id}": {
      "schema": { "$ref": "#/backend/entities/Task" },
      "description": "Process tasks."
    },
    "/processoModelos/{id}": {
      "schema": { "$ref": "#/backend/entities/ProcessoModelo" },
      "description": "Checklist models."
    },
    "/certifications/{id}": {
      "schema": { "$ref": "#/backend/entities/Certification" },
      "description": "Client certifications."
    },
    "/notifications/{id}": {
      "schema": { "$ref": "#/backend/entities/Notification" },
      "description": "User notifications."
    },
    "/chatMessages/{id}": {
      "schema": { "$ref": "#/backend/entities/ChatMessage" },
      "description": "Internal communication."
    },
    "/financialEntries/{id}": {
      "schema": { "$ref": "#/backend/entities/FinancialEntry" },
      "description": "Cash flow entries."
    },
    "/contracts/{id}": {
      "schema": { "$ref": "#/backend/entities/Contract" },
      "description": "Service contracts."
    }
  }
}