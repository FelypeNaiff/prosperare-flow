
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user account within the ContaHub system, managed by the Administrator.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity."
        },
        "fullName": {
          "type": "string",
          "description": "The full name of the user."
        },
        "email": {
          "type": "string",
          "description": "The Gmail address used for Google OAuth login."
        },
        "profile": {
          "type": "string",
          "description": "The role or profile of the user within the system.",
          "enum": ["ADMINISTRADOR", "SÓCIO", "CONTADOR/GESTOR", "ASSISTENTE"]
        },
        "departmentId": {
          "type": "string",
          "description": "Reference to the Department this user belongs to."
        },
        "status": {
          "type": "string",
          "description": "The current status of the user account.",
          "enum": ["ATIVO", "INATIVO"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "fullName",
        "email",
        "profile",
        "status",
        "createdAt"
      ]
    },
    "IrpfDeclaration": {
      "title": "IrpfDeclaration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "cpf": { "type": "string" },
        "govPass": { "type": "string" },
        "status": { "type": "string" },
        "progress": { "type": "number" },
        "value": { "type": "number" },
        "isPaid": { "type": "boolean" },
        "responsibleId": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": [
      "google.com",
      "password"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Stores individual user profiles."
        }
      },
      {
        "path": "/irpf_declarations/{id}",
        "definition": {
          "entityName": "IrpfDeclaration",
          "schema": {
            "$ref": "#/backend/entities/IrpfDeclaration"
          },
          "description": "Stores IRPF declarations individual by collaborator."
        }
      }
    ]
  }
}
