
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user account within the ContaHub system.",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "profile": { "type": "string", "enum": ["ADMINISTRADOR", "SÓCIO", "CONTADOR/GESTOR", "ASSISTENTE"] },
        "status": { "type": "string", "enum": ["ATIVO", "INATIVO"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName", "email", "profile", "status", "createdAt"]
    },
    "ProcessoModelo": {
      "title": "ProcessoModelo",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "descricao": { "type": "string" },
        "tipo": { "type": "string", "enum": ["recorrente", "esporadico"] },
        "regimes": { "type": "array", "items": { "type": "string" } },
        "departamento": { "type": "string" },
        "dataGeracaoRecorrencia": { "type": "number" },
        "recorrencia": { "type": "string", "enum": ["mensal", "bimestral", "trimestral", "semestral", "anual", "unica"] },
        "prazoFixo": { "type": "number" },
        "competencia": { "type": "string", "enum": ["mes_prazo", "mes_anterior", "mes_seguinte"] },
        "tarefas": { "type": "array" },
        "clientesVinculados": { "type": "array", "items": { "type": "string" } },
        "clientesExcluidos": { "type": "array", "items": { "type": "string" } },
        "ativo": { "type": "boolean" }
      }
    },
    "Processo": {
      "title": "Processo",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "modeloId": { "type": "string" },
        "clienteId": { "type": "string" },
        "nomeProcesso": { "type": "string" },
        "situacao": { "type": "string", "enum": ["a_fazer", "em_progresso", "concluido", "em_multa", "dispensado"] },
        "prazo": { "type": "string", "format": "date-time" },
        "prazoMeta": { "type": "string", "format": "date-time" },
        "atrasoGeraMulta": { "type": "boolean" },
        "tarefas": { "type": "array" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": { "entityName": "User", "description": "Stores individual user profiles." }
      },
      {
        "path": "/processoModelos/{id}",
        "definition": { "entityName": "ProcessoModelo", "description": "Blueprints for recurring or sporadic tasks." }
      },
      {
        "path": "/processos/{id}",
        "definition": { "entityName": "Processo", "description": "Actual process instances for clients." }
      }
    ]
  }
}
