
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents a user account within the ContaHub system.",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "profile": { "type": "string", "enum": ["ADMINISTRADOR", "SÓCIO", "CONTADOR/GESTOR", "ASSISTENTE"] },
        "status": { "type": "string", "enum": ["ATIVO", "INATIVO"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "departmentId": { "type": "string" },
        "departmentIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "fullName", "email", "profile", "status", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "type": "object",
      "description": "System notification for a specific user.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["assignment", "mention"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "processId": { "type": "string" }
      },
      "required": ["id", "userId", "title", "message", "type", "read", "createdAt"]
    },
    "Client": {
      "title": "Client",
      "type": "object",
      "description": "Client account details.",
      "properties": {
        "id": { "type": "string" },
        "corporateName": { "type": "string" },
        "cnpj": { "type": "string" },
        "taxRegime": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string" },
        "obligationGroups": { "type": "array", "items": { "type": "string" } },
        "healthScore": { "type": "number" }
      }
    },
    "ProcessoModelo": {
      "title": "ProcessoModelo",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "tipo": { "type": "string", "enum": ["recorrente", "esporadico"] },
        "departamento": { "type": "string" },
        "tarefas": { "type": "array" },
        "prazoFixo": { "type": "number" },
        "competencia": { "type": "string" }
      }
    },
    "Processo": {
      "title": "Processo",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "modeloId": { "type": "string" },
        "clienteId": { "type": "string" },
        "nomeProcesso": { "type": "string" },
        "situacao": { "type": "string", "enum": ["a_fazer", "em_progresso", "concluido", "em_multa", "dispensado"] },
        "competencia": { "type": "string" },
        "responsavelId": { "type": "string" },
        "auxiliarId": { "type": "string" },
        "comments": { "type": "array" }
      }
    },
    "Task": {
      "title": "Task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string" },
        "dueDate": { "type": "string" }
      }
    },
    "Installment": {
      "title": "Installment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "tipo": { "type": "string" },
        "status": { "type": "string" },
        "value": { "type": "number" },
        "totalParcels": { "type": "number" },
        "currentParcel": { "type": "number" },
        "dueDay": { "type": "number" }
      }
    },
    "IrpfDeclaration": {
      "title": "IrpfDeclaration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "cpf": { "type": "string" },
        "responsibleId": { "type": "string" },
        "status": { "type": "string" },
        "progress": { "type": "number" },
        "tags": { "type": "array" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/User" },
      "description": "Stores individual user profiles."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/backend/entities/Notification" },
      "description": "User notifications."
    },
    "/clients/{clientId}": {
      "schema": { "$ref": "#/backend/entities/Client" },
      "description": "Client profiles."
    },
    "/processoModelos/{id}": {
      "schema": { "$ref": "#/backend/entities/ProcessoModelo" },
      "description": "Blueprints for processes."
    },
    "/processos/{id}": {
      "schema": { "$ref": "#/backend/entities/Processo" },
      "description": "Actual process instances."
    },
    "/tasks/{id}": {
      "schema": { "$ref": "#/backend/entities/Task" },
      "description": "Individual process tasks."
    },
    "/installments/{id}": {
      "schema": { "$ref": "#/backend/entities/Installment" },
      "description": "Debt installments."
    },
    "/irpf_declarations/{id}": {
      "schema": { "$ref": "#/backend/entities/IrpfDeclaration" },
      "description": "IRPF Tax declarations."
    },
    "/irpf_stages/{id}": {
      "schema": { "type": "object" },
      "description": "Custom stages for IRPF Kanban."
    },
    "/clientAccesses/{id}": {
      "schema": { "type": "object" },
      "description": "Secure access storage for clients."
    },
    "/obligation_groups/{id}": {
      "schema": { "type": "object" },
      "description": "Groups of obligations for automation."
    },
    "/contracts/{id}": {
      "schema": { "type": "object" },
      "description": "Service contracts."
    },
    "/receivables/{id}": {
      "schema": { "type": "object" },
      "description": "Accounts receivable."
    },
    "/payables/{id}": {
      "schema": { "type": "object" },
      "description": "Accounts payable."
    },
    "/officeSettings/{id}": {
      "schema": { "type": "object" },
      "description": "Global office settings."
    }
  }
}
