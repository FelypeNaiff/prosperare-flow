
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents a user account within the ContaHub system.",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "profile": { "type": "string", "enum": ["ADMINISTRADOR", "SÓCIO", "CONTADOR/GESTOR", "ASSISTENTE"] },
        "status": { "type": "string", "enum": ["ATIVO", "INATIVO"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName", "email", "profile", "status", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "type": "object",
      "description": "System notification for a specific user.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["assignment", "mention"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "processId": { "type": "string" }
      },
      "required": ["id", "userId", "title", "message", "type", "read", "createdAt"]
    },
    "Client": {
      "title": "Client",
      "type": "object",
      "description": "Client account details.",
      "properties": {
        "id": { "type": "string" },
        "corporateName": { "type": "string" },
        "cnpj": { "type": "string" },
        "taxRegime": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string" },
        "obligationGroups": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ProcessoModelo": {
      "title": "ProcessoModelo",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "tipo": { "type": "string", "enum": ["recorrente", "esporadico"] },
        "departamento": { "type": "string" },
        "tarefas": { "type": "array" }
      }
    },
    "Processo": {
      "title": "Processo",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "modeloId": { "type": "string" },
        "clienteId": { "type": "string" },
        "nomeProcesso": { "type": "string" },
        "situacao": { "type": "string", "enum": ["a_fazer", "em_progresso", "concluido", "em_multa", "dispensado"] },
        "competencia": { "type": "string" }
      }
    },
    "Ticket": {
      "title": "Ticket",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string" },
        "responsibleId": { "type": "string" }
      }
    },
    "ObligationGroup": {
      "title": "ObligationGroup",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "dept": { "type": "string" },
        "processes": { "type": "array" }
      }
    },
    "Certificate": {
      "title": "Certificate",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "tipo": { "type": "string" },
        "validade": { "type": "string" }
      }
    },
    "Installment": {
      "title": "Installment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "tipo": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "FinanceRecord": {
      "title": "FinanceRecord",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "valor": { "type": "number" },
        "situacao": { "type": "string" }
      }
    },
    "Contract": {
      "title": "Contract",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "value": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/User" },
      "description": "Stores individual user profiles."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/backend/entities/Notification" },
      "description": "User notifications."
    },
    "/clients/{clientId}": {
      "schema": { "$ref": "#/backend/entities/Client" },
      "description": "Client profiles."
    },
    "/processoModelos/{id}": {
      "schema": { "$ref": "#/backend/entities/ProcessoModelo" },
      "description": "Blueprints for processes."
    },
    "/processos/{id}": {
      "schema": { "$ref": "#/backend/entities/Processo" },
      "description": "Actual process instances."
    },
    "/tickets/{id}": {
      "schema": { "$ref": "#/backend/entities/Ticket" },
      "description": "Internal demands."
    },
    "/obligation_groups/{id}": {
      "schema": { "$ref": "#/backend/entities/ObligationGroup" },
      "description": "Groups of obligations."
    },
    "/certificates/{id}": {
      "schema": { "$ref": "#/backend/entities/Certificate" },
      "description": "Digital certificates."
    },
    "/installments/{id}": {
      "schema": { "$ref": "#/backend/entities/Installment" },
      "description": "Debt installments."
    },
    "/receivables/{id}": {
      "schema": { "$ref": "#/backend/entities/FinanceRecord" },
      "description": "Accounts receivable."
    },
    "/payables/{id}": {
      "schema": { "$ref": "#/backend/entities/FinanceRecord" },
      "description": "Accounts payable."
    },
    "/contracts/{id}": {
      "schema": { "$ref": "#/backend/entities/Contract" },
      "description": "Service contracts."
    },
    "/officeSettings/{id}": {
      "schema": { "type": "object" },
      "description": "Global office settings."
    }
  }
}
