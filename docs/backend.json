
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents a user account within the ContaHub system.",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "profile": { "type": "string", "enum": ["ADMINISTRADOR", "SÓCIO", "CONTADOR/GESTOR", "ASSISTENTE"] },
        "status": { "type": "string", "enum": ["ATIVO", "INATIVO"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName", "email", "profile", "status", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "type": "object",
      "description": "System notification for a specific user.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["assignment", "mention"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "processId": { "type": "string" }
      },
      "required": ["id", "userId", "title", "message", "type", "read", "createdAt"]
    },
    "Client": {
      "title": "Client",
      "type": "object",
      "description": "Client account details.",
      "properties": {
        "id": { "type": "string" },
        "corporateName": { "type": "string" },
        "cnpj": { "type": "string" },
        "taxRegime": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "ProcessoModelo": {
      "title": "ProcessoModelo",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "descricao": { "type": "string" },
        "tipo": { "type": "string", "enum": ["recorrente", "esporadico"] },
        "departamento": { "type": "string" },
        "tarefas": { "type": "array" }
      }
    },
    "Processo": {
      "title": "Processo",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "modeloId": { "type": "string" },
        "clienteId": { "type": "string" },
        "nomeProcesso": { "type": "string" },
        "situacao": { "type": "string", "enum": ["a_fazer", "em_progresso", "concluido", "em_multa", "dispensado"] }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/User" },
      "description": "Stores individual user profiles."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/backend/entities/Notification" },
      "description": "User notifications."
    },
    "/clients/{clientId}": {
      "schema": { "$ref": "#/backend/entities/Client" },
      "description": "Client profiles."
    },
    "/processoModelos/{id}": {
      "schema": { "$ref": "#/backend/entities/ProcessoModelo" },
      "description": "Blueprints for processes."
    },
    "/processos/{id}": {
      "schema": { "$ref": "#/backend/entities/Processo" },
      "description": "Actual process instances."
    }
  }
}
